{
  "appId": "com.wewalastores.desktop",
  "productName": "Wewala Stores Desktop",
  "copyright": "Copyright © 2026 Wewala Stores (Pvt) Ltd",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "publish": {
    "provider": "github",
    "owner": "wewala-stores",
    "repo": "wewala-stores"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Wewala Stores POS & Admin"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.business",
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Office;Utility;Commercial;"
  }
}

