# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# ------------------------------------------------------------------------------
# LIVE PAYMENT GATEWAY CONFIGURATION (FOR REAL DEBIT / CREDIT CARDS)
# ------------------------------------------------------------------------------
# Provider options:
#   'payhere'  - PayHere Sri Lanka (CBSL approved, deposits LKR into any Sri Lankan bank)
#   'stripe'   - Stripe Live (Global Visa/Mastercard/Amex)
#   'terminal' - Interactive built-in test terminal
VITE_PAYMENT_GATEWAY=payhere

# PayHere Sri Lanka Credentials (from https://www.payhere.lk merchant portal):
VITE_PAYHERE_MERCHANT_ID=your_payhere_merchant_id
VITE_PAYHERE_SECRET=your_payhere_merchant_secret
# Set to 'false' to charge REAL MONEY from debit cards!
# Set to 'true' for sandbox testing.
VITE_PAYHERE_SANDBOX=false

# Stripe Configuration (optional, if using Stripe):
# STRIPE_SECRET_KEY=sk_live_... (Set in Supabase Edge Function Secrets)
# STRIPE_WEBHOOK_SECRET=whsec_... (Set in Supabase Edge Function Secrets)
